# Copy to .env for local development. Set production values in the hosting provider.
NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_SECRET=

# Optional initial privileged accounts. Keep these values in hosting-provider secrets only.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_STAFF_USERNAME=
BOOTSTRAP_STAFF_PASSWORD=

# Optional cross-origin frontend origin; leave unset when frontend and API share one service.
CORS_ORIGIN=

# Optional menu image uploads; requires a configured AWS S3 bucket and credentials/role.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
